<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/teacherRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_bg"
    tools:context=".TeacherActivity">

    <!-- ── Premium Top Bar ── -->
    <LinearLayout
        android:id="@+id/teacherHeaderContainer"
        android:layout_width="0dp"
        android:layout_height="68dp"
        android:background="@color/color_surface"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Logo mark + wordmark -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Olive logo square -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="36dp"
                android:layout_height="36dp"
                app:cardBackgroundColor="@color/color_primary"
                app:cardCornerRadius="10dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="7dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/logo_2"
                    app:tint="@color/white" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Title stack -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <!-- App name + role badge -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="-0.01"
                        android:text="CampusCircle"
                        android:textColor="@color/color_text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_pill_primary"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="2dp"
                        android:text="TEACHER"
                        android:textColor="@color/color_primary"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.06" />
                </LinearLayout>

                <!-- Dynamic user name -->
                <TextView
                    android:id="@+id/teacherHeaderUserName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:alpha="0.55"
                    android:fontFamily="sans-serif"
                    android:text="Welcome, Teacher"
                    android:textColor="@color/color_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Notification bell -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="10dp"
            app:cardBackgroundColor="@color/color_surface_variant"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <ImageView
                android:id="@+id/teacherNotificationBtn"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Notifications"
                android:padding="8dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_bell"
                app:tint="@color/color_text_secondary" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Profile avatar -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="38dp"
            android:layout_height="38dp"
            app:cardBackgroundColor="@color/color_primary_container"
            app:cardCornerRadius="11dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/color_border"
            app:strokeWidth="1dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/teacherProfileImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Profile"
                android:scaleType="centerCrop"
                android:src="@drawable/logo_2"
                app:tint="@color/color_primary" />
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    <!-- Header bottom divider -->
    <View
        android:id="@+id/teacherHeaderDivider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="@color/color_border"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/teacherHeaderContainer" />

    <!-- Fragment canvas -->
    <FrameLayout
        android:id="@+id/teacherFragmentContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/color_bg"
        app:layout_constraintBottom_toTopOf="@id/teacherNavCard"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/teacherHeaderDivider" />

    <!-- ── Floating Bottom Navigation Card ── -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/teacherNavCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginBottom="16dp"
        app:cardBackgroundColor="@color/color_surface"
        app:cardCornerRadius="28dp"
        app:cardElevation="16dp"
        app:strokeWidth="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/teacherBottomNavigation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            app:elevation="0dp"
            app:itemActiveIndicatorStyle="@style/Widget.Custom.BottomNavActiveIndicator"
            app:itemIconSize="22dp"
            app:itemIconTint="@color/bottom_nav_item_color"
            app:itemRippleColor="#0D3B4D24"
            app:itemTextColor="@color/bottom_nav_item_color"
            app:labelVisibilityMode="labeled"
            app:menu="@menu/teacher_bottom_nav_menu" />

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>

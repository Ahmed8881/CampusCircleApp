<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FCFDFB"> <!-- Cohesive premium off-white canvas -->

    <!-- Ambient soft olive glow behind the logo -->
    <View
        android:layout_width="320dp"
        android:layout_height="320dp"
        android:alpha="0.15"
        android:background="@drawable/bg_splash_glow"
        android:backgroundTint="#3B4D24"
        app:layout_constraintBottom_toBottomOf="@+id/logo"
        app:layout_constraintEnd_toEndOf="@+id/logo"
        app:layout_constraintStart_toStartOf="@+id/logo"
        app:layout_constraintTop_toTopOf="@+id/logo" />

    <!-- Outer sleek pulse ring -->
    <View
        android:id="@+id/ringOuter"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:alpha="0.25"
        android:background="@drawable/bg_pulse_ring"
        android:backgroundTint="#F1F4EE"
        app:layout_constraintBottom_toBottomOf="@+id/logo"
        app:layout_constraintEnd_toEndOf="@+id/logo"
        app:layout_constraintStart_toStartOf="@+id/logo"
        app:layout_constraintTop_toTopOf="@+id/logo" />

    <!-- Mid sleek pulse ring -->
    <View
        android:id="@+id/ringMid"
        android:layout_width="170dp"
        android:layout_height="170dp"
        android:alpha="0.45"
        android:background="@drawable/bg_pulse_ring"
        android:backgroundTint="#F1F4EE"
        app:layout_constraintBottom_toBottomOf="@+id/logo"
        app:layout_constraintEnd_toEndOf="@+id/logo"
        app:layout_constraintStart_toStartOf="@+id/logo"
        app:layout_constraintTop_toTopOf="@+id/logo" />

    <!-- Inner sleek pulse ring -->
    <View
        android:id="@+id/ringInner"
        android:layout_width="128dp"
        android:layout_height="128dp"
        android:alpha="0.75"
        android:background="@drawable/bg_pulse_ring"
        android:backgroundTint="#E3E6DF"
        app:layout_constraintBottom_toBottomOf="@+id/logo"
        app:layout_constraintEnd_toEndOf="@+id/logo"
        app:layout_constraintStart_toStartOf="@+id/logo"
        app:layout_constraintTop_toTopOf="@+id/logo" />

    <ImageView
        android:id="@+id/logo"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:scaleType="centerInside"
        android:src="@drawable/logo_web"
        app:layout_constraintBottom_toTopOf="@+id/appName"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.44"
        app:layout_constraintVertical_chainStyle="packed" />

    <!-- App Name (Dark Forest charcoal for premium editorial contrast) -->
    <TextView
        android:id="@+id/appName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:fontFamily="sans-serif-black"
        android:letterSpacing="-0.03"
        android:text="CampusCircle"
        android:textColor="#191F11"
        android:textSize="36sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/tagline"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/logo" />

    <!-- Premium Muted Accent Tagline -->
    <TextView
        android:id="@+id/tagline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.25"
        android:text="CONNECT  ·  LEARN  ·  GROW"
        android:textAllCaps="true"
        android:textColor="#5C6453"
        android:textSize="11sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/appName" />

    <!-- Subtle, Minimalist Institutional Signature at bottom -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="40dp"
        android:fontFamily="sans-serif"
        android:letterSpacing="0.2"
        android:text="UET LAHORE"
        android:textAllCaps="true"
        android:textColor="#A3AB9A"
        android:textSize="11sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_bg">

    <!-- Top-right ambient glow -->
    <View
        android:layout_width="320dp"
        android:layout_height="320dp"
        android:alpha="0.55"
        android:background="@drawable/bg_splash_glow"
        android:translationX="80dp"
        android:translationY="-80dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Bottom-left secondary glow (cyan tinted) -->
    <View
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:alpha="0.18"
        android:background="@drawable/bg_splash_glow"
        android:translationX="-50dp"
        android:translationY="50dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="28dp"
            android:paddingTop="48dp"
            android:paddingBottom="40dp">

            <!-- Logo -->
            <ImageView
                android:id="@+id/logo"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:src="@drawable/logo_2" />

            <!-- Title -->
            <TextView
                android:id="@+id/loginTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="-0.02"
                android:text="Welcome back"
                android:textColor="@color/color_text_primary"
                android:textSize="32sp" />

            <!-- Subtitle -->
            <TextView
                android:id="@+id/loginSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:alpha="0.7"
                android:text="Sign in to continue to CampusCircle"
                android:textColor="@color/color_text_secondary"
                android:textSize="15sp" />

            <!-- Email field -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/emailLayout"
                style="@style/Widget.App.TextInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="36dp"
                android:hint="Email address"
                app:boxStrokeColor="@color/color_primary"
                app:hintTextColor="@color/color_text_muted"
                app:startIconDrawable="@android:drawable/ic_dialog_email"
                app:startIconTint="@color/color_text_muted">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/emailInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textEmailAddress"
                    android:textColor="@color/color_text_primary"
                    android:textSize="16sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Password field -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/passwordLayout"
                style="@style/Widget.App.TextInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="Password"
                app:boxStrokeColor="@color/color_primary"
                app:hintTextColor="@color/color_text_muted"
                app:passwordToggleEnabled="true"
                app:passwordToggleTint="@color/color_text_muted"
                app:startIconDrawable="@android:drawable/ic_lock_idle_lock"
                app:startIconTint="@color/color_text_muted">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/passwordInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:textColor="@color/color_text_primary"
                    android:textSize="16sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Forgot password -->
            <TextView
                android:id="@+id/forgotPassword"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="14dp"
                android:padding="8dp"
                android:text="Forgot password?"
                android:textColor="@color/color_primary_light"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Sign In button (gradient) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/loginBtn"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_gradient_primary"
                android:text="Sign In"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="17sp"
                android:textStyle="bold"
                app:backgroundTint="@null"
                app:cornerRadius="16dp"
                app:insetBottom="0dp"
                app:insetTop="0dp" />

            <!-- OR divider -->
            <LinearLayout
                android:id="@+id/divider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:alpha="0.3"
                    android:background="@color/color_border" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="16dp"
                    android:text="or"
                    android:textColor="@color/color_text_muted"
                    android:textSize="13sp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:alpha="0.3"
                    android:background="@color/color_border" />
            </LinearLayout>

            <!-- Google Sign In -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/googleSignInBtn"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="20dp"
                android:text="Continue with Google"
                android:textAllCaps="false"
                android:textColor="@color/color_text_primary"
                android:textSize="15sp"
                app:backgroundTint="@color/color_surface_variant"
                app:cornerRadius="16dp"
                app:icon="@drawable/google"
                app:iconGravity="textStart"
                app:iconPadding="12dp"
                app:iconTint="@null"
                app:insetBottom="0dp"
                app:insetTop="0dp"
                app:strokeColor="@color/color_border"
                app:strokeWidth="1dp" />

            <!-- Sign Up link -->
            <TextView
                android:id="@+id/signupText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:padding="8dp"
                android:text="New here? Create an account"
                android:textColor="@color/color_primary_light"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>
    </ScrollView>

    <include android:id="@+id/globalLoader" layout="@layout/view_global_loader" />

</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingVertical="10dp">

    <!-- Time column -->
    <LinearLayout
        android:layout_width="56dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/timetableStartTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_medium"
            android:text="09:00"
            android:textColor="?attr/colorTextBody"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/timetableEndTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:alpha="0.55"
            android:text="10:00"
            android:textColor="?attr/colorTextMuted"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Timeline: dot + line -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="12dp">

        <View
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/bg_timetable_dot" />

        <View
            android:layout_width="2dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:alpha="0.25"
            android:background="?attr/colorPrimary" />
    </LinearLayout>

    <!-- Course info -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/timetableCourseName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter_medium"
            android:text="Mathematics"
            android:textColor="?attr/colorTextHeading"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/timetableCourseCode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_primary"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:text="MATH101"
                android:textColor="?attr/colorPrimary"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="6dp"
                android:alpha="0.40"
                android:text="·"
                android:textColor="?attr/colorTextMuted"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/timetableRoom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="0.70"
                android:text="Room A"
                android:textColor="?attr/colorTextBody"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>

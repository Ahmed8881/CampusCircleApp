<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://tools.android.com/tools"
    android:id="@+id/adminRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FCFDFB"
    tools:context=".AdminActivity">

    <!-- Top Premium Header Bar -->
    <LinearLayout
        android:id="@+id/adminHeaderContainer"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:background="#FFFFFF"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Title Section -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="-0.02"
                android:text="CampusCircle"
                android:textColor="#191F11"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/adminHeaderUserName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif"
                android:letterSpacing="0.06"
                android:text="ADMIN PORTAL"
                android:textColor="#3B4D24"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Premium Modern Rounded Profile Frame -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="40dp"
            android:layout_height="40dp"
            app:cardBackgroundColor="#F1F4EE"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp"
            app:strokeColor="#E3E6DF"
            app:strokeWidth="1dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/adminProfileImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Admin Profile"
                android:padding="8dp"
                android:scaleType="centerInside"
                android:src="@drawable/logo_2"
                app:tint="#3B4D24" />
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    <!-- Sleek Minimalist Border Line beneath the header -->
    <View
        android:id="@+id/headerDivider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="#E3E6DF"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/adminHeaderContainer" />

    <!-- Fragment Canvas Area -->
    <FrameLayout
        android:id="@+id/adminFragmentContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#FCFDFB"
        app:layout_constraintBottom_toTopOf="@id/navigationDivider"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerDivider" />

    <!-- Sleek Minimalist Border Line above navigation bar -->
    <View
        android:id="@+id/navigationDivider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="#E3E6DF"
        app:layout_constraintBottom_toTopOf="@id/adminBottomNavigation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Premium Clean Bottom Navigation Menu -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/adminBottomNavigation"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:background="#FFFFFF"
        app:elevation="0dp"
        app:itemActiveIndicatorStyle="@null"
        app:itemIconSize="22dp"
        app:itemRippleColor="#0D3B4D24"
        app:labelVisibilityMode="labeled"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:menu="@menu/admin_bottom_nav_menu" />

</androidx.constraintlayout.widget.ConstraintLayout>
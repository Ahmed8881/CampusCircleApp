<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/adminRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/android:colorBackground"
    tools:context=".AdminActivity">

    <!-- ── Premium Top Bar ── -->
    <LinearLayout
        android:id="@+id/adminHeaderContainer"
        android:layout_width="0dp"
        android:layout_height="68dp"
        android:background="?attr/colorSurface"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Logo mark + wordmark -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Olive logo square -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="36dp"
                android:layout_height="36dp"
                app:cardBackgroundColor="?attr/colorPrimary"
                app:cardCornerRadius="10dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="7dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/logo_2"
                    app:tint="?attr/colorOnPrimary" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Title stack -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <!-- App name + role badge -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_medium"
                        android:letterSpacing="-0.01"
                        android:text="CampusCircle"
                        android:textColor="?attr/colorTextHeading"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_pill_primary"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="2dp"
                        android:text="ADMIN"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.06" />
                </LinearLayout>

                <!-- Dynamic admin user name (set by AdminActivity) -->
                <TextView
                    android:id="@+id/adminHeaderUserName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:alpha="0.55"
                    android:fontFamily="@font/inter_regular"
                    android:text="Welcome"
                    android:textColor="?attr/colorTextBody"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Notification bell -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="10dp"
            app:cardBackgroundColor="?attr/colorSurfaceVariant"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <ImageView
                android:id="@+id/adminNotificationBtn"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Notifications"
                android:padding="8dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_bell"
                app:tint="?attr/colorTextBody" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Profile avatar -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="38dp"
            android:layout_height="38dp"
            app:cardBackgroundColor="?attr/colorPrimaryContainer"
            app:cardCornerRadius="11dp"
            app:cardElevation="0dp"
            app:strokeColor="?attr/colorOutline"
            app:strokeWidth="1dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/adminProfileImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Admin Profile"
                android:scaleType="centerCrop"
                android:src="@drawable/logo_2"
                app:tint="?attr/colorPrimary" />
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    <!-- Header bottom divider -->
    <View
        android:id="@+id/headerDivider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="?attr/colorOutline"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/adminHeaderContainer" />

    <!-- Fragment canvas -->
    <FrameLayout
        android:id="@+id/adminFragmentContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="?attr/android:colorBackground"
        app:layout_constraintBottom_toTopOf="@id/adminNavCard"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerDivider" />

    <!-- ── Floating Bottom Navigation Card ── -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/adminNavCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginBottom="16dp"
        app:cardBackgroundColor="?attr/colorSurface"
        app:cardCornerRadius="28dp"
        app:cardElevation="16dp"
        app:strokeWidth="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/adminBottomNavigation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            app:elevation="0dp"
            app:itemActiveIndicatorStyle="@style/Widget.Custom.BottomNavActiveIndicator"
            app:itemIconSize="22dp"
            app:itemIconTint="@color/bottom_nav_item_color"
            app:itemRippleColor="?attr/colorControlHighlight"
            app:itemTextColor="@color/bottom_nav_item_color"
            app:labelVisibilityMode="labeled"
            app:menu="@menu/admin_bottom_nav_menu" />

    </com.google.android.material.card.MaterialCardView>

    <!-- Legacy kept for constraint compatibility -->
    <View
        android:id="@+id/navigationDivider"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/adminNavCard"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ══════════════ Text Appearances ══════════════ -->

    <style name="TextAppearance.App" parent="TextAppearance.Material3.BodyMedium" />

    <style name="TextAppearance.App.Display" parent="TextAppearance.App">
        <item name="android:fontFamily">@font/instrument_serif_regular</item>
        <item name="android:textSize">40sp</item>
        <item name="android:letterSpacing">-0.03</item>
        <item name="android:textColor">?attr/colorTextHeading</item>
    </style>

    <style name="TextAppearance.App.Headline" parent="TextAppearance.App">
        <item name="android:fontFamily">@font/instrument_serif_regular</item>
        <item name="android:textSize">32sp</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:textColor">?attr/colorTextHeading</item>
    </style>

    <style name="TextAppearance.App.HeadlineSans" parent="TextAppearance.App">
        <item name="android:fontFamily">@font/inter_bold</item>
        <item name="android:textSize">28sp</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:textColor">?attr/colorTextHeading</item>
    </style>

    <style name="TextAppearance.App.Title" parent="TextAppearance.App">
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">?attr/colorTextHeading</item>
    </style>

    <style name="TextAppearance.App.Body" parent="TextAppearance.App">
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">?attr/colorTextBody</item>
        <item name="android:lineSpacingMultiplier">1.5</item>
    </style>

    <style name="TextAppearance.App.BodyMedium" parent="TextAppearance.App">
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">?attr/colorTextBody</item>
        <item name="android:lineSpacingMultiplier">1.5</item>
    </style>

    <style name="TextAppearance.App.Caption" parent="TextAppearance.App">
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">?attr/colorTextMuted</item>
        <item name="android:letterSpacing">0.04</item>
    </style>

    <style name="TextAppearance.App.Label" parent="TextAppearance.App">
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textColor">?attr/colorTextMuted</item>
    </style>

    <!-- ══════════════ Buttons ══════════════ -->

    <style name="Widget.App.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="backgroundTint">?attr/colorPrimary</item>
        <item name="android:textColor">?attr/colorOnPrimary</item>
    </style>

    <style name="Widget.App.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="strokeColor">?attr/colorOutline</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="Widget.App.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>

    <!-- ══════════════ Cards ══════════════ -->

    <style name="Widget.App.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">?attr/colorSurface</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">?attr/colorOutline</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Widget.App.Card.Elevated" parent="Widget.App.Card">
        <item name="cardBackgroundColor">?attr/colorSurfaceElevated</item>
        <item name="cardElevation">4dp</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="Widget.App.Card.Primary" parent="Widget.App.Card">
        <item name="cardBackgroundColor">?attr/colorPrimaryContainer</item>
        <item name="strokeColor">?attr/colorOutline</item>
    </style>

    <!-- ══════════════ TextInput ══════════════ -->

    <style name="Widget.App.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">?attr/colorSurfaceVariant</item>
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="boxStrokeWidth">0dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="hintTextColor">?attr/colorPrimary</item>
        <item name="android:textColorHint">?attr/colorTextMuted</item>
        <item name="startIconTint">?attr/colorTextMuted</item>
        <item name="endIconTint">?attr/colorTextMuted</item>
        <item name="android:fontFamily">@font/inter_regular</item>
    </style>

    <!-- ══════════════ Bottom Navigation ══════════════ -->

    <style name="Widget.App.NavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">?attr/colorPrimaryContainer</item>
        <item name="android:width">60dp</item>
        <item name="android:height">34dp</item>
    </style>

    <style name="Widget.Custom.BottomNavActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">?attr/colorPrimaryContainer</item>
        <item name="android:width">60dp</item>
        <item name="android:height">34dp</item>
    </style>

    <!-- ══════════════ Header ══════════════ -->

    <style name="Widget.App.Header" parent="">
        <item name="android:background">?attr/colorSurface</item>
        <item name="android:elevation">2dp</item>
    </style>

    <!-- ══════════════ Progress ══════════════ -->

    <style name="Widget.App.ProgressIndicator" parent="Widget.Material3.CircularProgressIndicator">
        <item name="indicatorColor">?attr/colorPrimary</item>
        <item name="trackColor">?attr/colorOutline</item>
    </style>

    <!-- ══════════════ Shape Appearances ══════════════ -->

    <style name="ShapeAppearance.App" parent="ShapeAppearance.Material3.MediumComponent" />

    <style name="ShapeAppearance.App.Circle" parent="ShapeAppearance.App">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="ShapeAppearance.App.ExtraLarge" parent="ShapeAppearance.App">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>

</resources>

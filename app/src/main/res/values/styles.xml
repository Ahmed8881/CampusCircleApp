<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ══════════════ Text Appearances ══════════════ -->

    <style name="TextAppearance.App.Display">
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:textSize">40sp</item>
        <item name="android:letterSpacing">-0.03</item>
        <item name="android:textColor">@color/color_text_primary</item>
    </style>

    <style name="TextAppearance.App.Headline">
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:textSize">32sp</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:textColor">@color/color_text_primary</item>
    </style>

    <style name="TextAppearance.App.Title">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/color_text_primary</item>
    </style>

    <style name="TextAppearance.App.Body">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/color_text_secondary</item>
        <item name="android:lineSpacingMultiplier">1.5</item>
    </style>

    <style name="TextAppearance.App.Caption">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/color_text_muted</item>
        <item name="android:letterSpacing">0.04</item>
    </style>

    <style name="TextAppearance.App.Label">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textColor">@color/color_text_muted</item>
    </style>

    <!-- ══════════════ Buttons ══════════════ -->

    <style name="Widget.App.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="backgroundTint">@color/color_primary</item>
        <item name="android:textColor">@color/color_on_primary</item>
    </style>

    <style name="Widget.App.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="strokeColor">@color/color_border</item>
        <item name="android:textColor">@color/color_text_primary</item>
    </style>

    <style name="Widget.App.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/color_primary</item>
    </style>

    <!-- ══════════════ Cards ══════════════ -->

    <style name="Widget.App.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/color_card</item>
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/color_border</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Widget.App.Card.Elevated" parent="Widget.App.Card">
        <item name="cardBackgroundColor">@color/color_card_elevated</item>
        <item name="cardElevation">6dp</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="Widget.App.Card.Primary" parent="Widget.App.Card">
        <item name="cardBackgroundColor">@color/color_primary_container</item>
        <item name="strokeColor">@color/color_primary_dark</item>
    </style>

    <!-- ══════════════ TextInput ══════════════ -->

    <style name="Widget.App.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/color_surface_variant</item>
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="boxStrokeColor">@color/color_border</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="hintTextColor">@color/color_text_muted</item>
        <item name="android:textColorHint">@color/color_text_muted</item>
        <item name="startIconTint">@color/color_text_muted</item>
        <item name="endIconTint">@color/color_text_muted</item>
    </style>

    <!-- ══════════════ Bottom Navigation ══════════════ -->

    <style name="Widget.App.NavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/nav_indicator</item>
    </style>

    <!-- ══════════════ Progress ══════════════ -->

    <style name="Widget.App.ProgressIndicator" parent="Widget.Material3.CircularProgressIndicator">
        <item name="indicatorColor">@color/color_primary</item>
        <item name="trackColor">@color/color_border</item>
    </style>

    <!-- ══════════════ Shape Appearances ══════════════ -->

    <style name="ShapeAppearance.App.Circle">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="ShapeAppearance.App.ExtraLarge">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>

</resources>

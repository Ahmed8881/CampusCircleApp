<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.CampusCircleApp" parent="Theme.Material3.Light.NoActionBar">
        <!-- Primary — Deep Olive -->
        <item name="colorPrimary">@color/color_primary</item>
        <item name="colorOnPrimary">@color/color_on_primary</item>
        <item name="colorPrimaryContainer">@color/color_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/color_on_primary_container</item>

        <!-- Secondary — Sage -->
        <item name="colorSecondary">@color/color_secondary</item>
        <item name="colorOnSecondary">@color/color_on_secondary</item>
        <item name="colorSecondaryContainer">@color/color_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/color_on_secondary_container</item>

        <!-- Tertiary — Amber -->
        <item name="colorTertiary">@color/color_warning</item>
        <item name="colorOnTertiary">@color/color_text_inverse</item>

        <!-- Error -->
        <item name="colorError">@color/color_error</item>
        <item name="colorOnError">@color/color_text_inverse</item>

        <!-- Backgrounds and surfaces — light -->
        <item name="android:colorBackground">@color/color_bg</item>
        <item name="colorSurface">@color/color_surface</item>
        <item name="colorOnSurface">@color/color_text_primary</item>
        <item name="colorSurfaceVariant">@color/color_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/color_text_secondary</item>

        <!-- Outline -->
        <item name="colorOutline">@color/color_border</item>
        <item name="colorOutlineVariant">@color/color_border_subtle</item>

        <!-- Status bars — light mode icons -->
        <item name="android:statusBarColor">@color/color_bg</item>
        <item name="android:navigationBarColor">@color/color_surface</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>

        <!-- Ripple & controls -->
        <item name="colorControlHighlight">@color/color_overlay_light</item>
        <item name="colorControlActivated">@color/color_primary</item>
        <item name="colorControlNormal">@color/color_text_muted</item>

        <!-- Typography defaults -->
        <item name="android:textColor">@color/color_text_primary</item>
        <item name="android:textColorSecondary">@color/color_text_secondary</item>
        <item name="android:textColorHint">@color/color_text_muted</item>
    </style>

    <style name="Theme.CampusCircleApp" parent="Base.Theme.CampusCircleApp" />

    <style name="Theme.CampusCircleApp.Splash" parent="Theme.CampusCircleApp">
        <item name="android:windowBackground">@color/color_bg</item>
    </style>
</resources>
